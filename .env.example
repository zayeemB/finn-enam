# Local development uses embedded PostgreSQL in data/node/postgres/.
# Set DATABASE_URL to use managed PostgreSQL instead. Never disable TLS validation.
DATABASE_URL=
FINN_DATA_DIR=data/node

# Required on Vercel: private Vercel Blob storage for temporary assets.
BLOB_READ_WRITE_TOKEN=

# Required for protected worker/read calls. Scheduler sends Authorization: Bearer <secret>.
CRON_SECRET=
# Browser signs in with this demo-only code; it never receives CRON_SECRET/API keys.
# Local npm run dev prints a temporary code if this is empty. Hosted API requires it.
DEMO_ACCESS_CODE=
# Set to the exact frontend origin when hosted, e.g. https://your-demo.example.
APP_ORIGIN=
PORT=3001

# Keep invocations bounded. Repeat calls resume queued downloads and company checks.
COLLECTOR_BUDGET_MS=45000
COLLECTOR_COMPANY_LIMIT=5
COLLECTOR_DOWNLOAD_LIMIT=10
COLLECTOR_OVERLAP_MINUTES=60
COLLECTOR_BOOTSTRAP_HOURS=24

# Extraction prepares full text plus rendered page images, resuming long PDFs across calls.
EXTRACTOR_BUDGET_MS=45000
EXTRACTOR_PAGE_LIMIT=10
EXTRACTOR_JOB_LIMIT=3
EXTRACTOR_PAGE_TIMEOUT_MS=20000
EXTRACTOR_RENDER_SCALE=1.5
EXTRACTOR_MAX_PIXELS=6000000

# Configure in a local ignored .env or server secret settings. Never paste keys into chat.
GEMINI_API_KEY=
# Optional secondary key, tried when the primary key reaches a request limit.
GEMINI_API_KEY_SECONDARY=
# Gemini stages use these explicit models. 3.5 Flash is deprecated/rerouted to 3.6.
GEMINI_EXTRACTION_MODEL=gemini-3.1-flash-lite
GEMINI_REASONING_MODEL=gemini-3.6-flash
# Optional alternatives within each stage; no 3.8 requests by default.
GEMINI_EXTRACTION_FALLBACK_MODEL=
GEMINI_REASONING_FALLBACK_MODEL=
# Optional: low, medium or high. Empty preserves the provider's default reasoning level.
GEMINI_THINKING_LEVEL=
# Focused research has a separate low-latency model pair.
# Full text index, then adaptive evidence selection with no page-count cap.
# Each pass sends at most 18k source characters and 1 page image. Usually 1-2 passes.
# Up to 3 requests, 30 seconds each, within a 180-second processing budget.
RESEARCH_MODEL=gemini-3.5-flash-lite
RESEARCH_FALLBACK_MODEL=gemini-3.6-flash
# Optional after validating GROQ_API_KEY: set RESEARCH_FALLBACK_PROVIDER=groq.
RESEARCH_FALLBACK_PROVIDER=gemini
# Local diagnostic: allow up to five minutes per request.
GEMINI_DIAGNOSTIC_TIMEOUT_MS=300000
# Groq is a separate provider. Store its key only in .env/server secrets.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_OUTPUT_TOKENS=900
# Default remains Gemini. Set to groq to use Groq as the primary provider.
ANALYSIS_PROVIDER=gemini
# Applies to the Groq primary path only; Gemini has separate stage fallback settings above.
ANALYSIS_FALLBACK_PROVIDER=
# Monitoring analysis is bounded on local and hosted invocations.
# Large filings use selected passages, one image, cached extraction and synthesis.
# Hosted /api/analyse caps budget at 45 seconds total / 40 seconds per request.
ANALYSIS_BUDGET_MS=180000
ANALYSIS_REQUEST_TIMEOUT_MS=30000
ANALYSIS_CALL_LIMIT=2
ANALYSIS_JOB_LIMIT=1
ANALYSIS_PAGES_PER_BATCH=2
ANALYSIS_SYNTHESIS_CHARS=180000

# Optional migration-role/direct URL; falls back to DATABASE_URL. Retain TLS/CA settings.
DATABASE_MIGRATION_URL=
